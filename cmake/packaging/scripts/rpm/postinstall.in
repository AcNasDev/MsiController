#!/bin/sh
set -e
cd /

DKMS_NAME="@MSICONTROLLER_DKMS_MODULE_NAME@"
DKMS_VERSION="@MSICONTROLLER_DKMS_VERSION@"
SERVICE_NAME="msi-ec-service.service"
REPOSITORY_ENABLED="@MSICONTROLLER_PACKAGE_REPOSITORY_ENABLE@"
REPOSITORY_BASE_URL="@MSICONTROLLER_PACKAGE_REPOSITORY_BASE_URL@"
REPOSITORY_OWNER="@MSICONTROLLER_PACKAGE_REPOSITORY_OWNER@"
RPM_GROUP="@MSICONTROLLER_PACKAGE_RPM_GROUP@"
RPM_REPO_FILE="/etc/yum.repos.d/msicontroller-forgejo.repo"

skip_dkms() {
    [ "${MSICONTROLLER_SKIP_DKMS:-0}" = "1" ]
}

skip_repository_setup() {
    [ "${MSICONTROLLER_DISABLE_REPOSITORY_SETUP:-0}" = "1" ]
}

repository_enabled() {
    [ "$REPOSITORY_ENABLED" = "ON" ] || [ "$REPOSITORY_ENABLED" = "1" ] || [ "$REPOSITORY_ENABLED" = "TRUE" ]
}

configure_rpm_repository() {
    repository_enabled || return 0
    skip_repository_setup && return 0
    [ -n "$REPOSITORY_BASE_URL" ] || return 0
    [ -n "$REPOSITORY_OWNER" ] || return 0
    [ -d /etc ] || return 0

    repo_url="${REPOSITORY_BASE_URL%/}/api/packages/${REPOSITORY_OWNER}/rpm"
    if [ -n "$RPM_GROUP" ]; then
        repo_url="${repo_url}/${RPM_GROUP}"
    fi
    gpgkey_url="${REPOSITORY_BASE_URL%/}/api/packages/${REPOSITORY_OWNER}/rpm/repository.key"

    mkdir -p /etc/yum.repos.d
    cat > "$RPM_REPO_FILE" <<EOF
[msicontroller-forgejo]
name=MSI Control Center Forgejo Packages
baseurl=${repo_url}
enabled=1
gpgcheck=1
gpgkey=${gpgkey_url}
repo_gpgcheck=0
metadata_expire=6h
skip_if_unavailable=1
type=rpm-md
EOF
    chmod 0644 "$RPM_REPO_FILE"
}

cleanup_broken_dkms_versions() {
    dkms status -m "$DKMS_NAME" 2>/dev/null | \
        awk -F'[/,:]' -v module="$DKMS_NAME" '$1 == module && $0 ~ /: broken/ { print $2 }' | \
        while IFS= read -r stale_version; do
            [ -n "$stale_version" ] || continue
            [ "$stale_version" = "$DKMS_VERSION" ] && continue
            dkms remove -m "$DKMS_NAME" -v "$stale_version" --all >/dev/null 2>&1 || true
        done
}

installed_kernel_module_path() {
    kernel_version="$1"
    command -v modinfo >/dev/null 2>&1 || return 1
    modinfo -k "$kernel_version" -n "$DKMS_NAME" 2>/dev/null
}

module_layout_crc() {
    awk '$2 == "module_layout" { print $1; exit }' "$1"
}

installed_module_layout_crc() {
    module_path="$1"
    command -v modprobe >/dev/null 2>&1 || return 1
    modprobe --dump-modversions "$module_path" 2>/dev/null | \
        awk '$2 == "module_layout" { print $1; exit }'
}

dkms_module_matches_kernel() {
    kernel_version="$1"
    symvers="/lib/modules/$kernel_version/build/Module.symvers"

    [ -r "$symvers" ] || return 2
    command -v modinfo >/dev/null 2>&1 || return 2
    command -v modprobe >/dev/null 2>&1 || return 2

    module_path="$(installed_kernel_module_path "$kernel_version")" || return 1
    [ -n "$module_path" ] || return 1
    [ -e "$module_path" ] || return 1

    expected_crc="$(module_layout_crc "$symvers")"
    actual_crc="$(installed_module_layout_crc "$module_path")"
    [ -n "$expected_crc" ] || return 2
    [ -n "$actual_crc" ] || return 1
    [ "$actual_crc" = "$expected_crc" ]
}

ensure_current_dkms_module() {
    kernel_version="$1"

    if dkms status -m "$DKMS_NAME" -v "$DKMS_VERSION" -k "$kernel_version" 2>/dev/null | grep -q "installed"; then
        dkms_module_matches_kernel "$kernel_version"
        module_state=$?
        if [ "$module_state" -eq 0 ]; then
            return 0
        fi
        if [ "$module_state" -eq 2 ]; then
            echo "msicontroller: warning: unable to validate $DKMS_NAME for kernel $kernel_version; keeping installed DKMS module" >&2
            return 0
        fi
        echo "msicontroller: warning: rebuilding $DKMS_NAME for kernel $kernel_version because installed module symbols do not match" >&2
    fi

    dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" -k "$kernel_version" >/dev/null 2>&1 || true
    dkms build -m "$DKMS_NAME" -v "$DKMS_VERSION" -k "$kernel_version"
    dkms install -m "$DKMS_NAME" -v "$DKMS_VERSION" -k "$kernel_version" --force
}

configure_rpm_repository

if ! skip_dkms && command -v dkms >/dev/null 2>&1; then
    cleanup_broken_dkms_versions
    dkms add -m "$DKMS_NAME" -v "$DKMS_VERSION" >/dev/null 2>&1 || true
    KERNEL_VERSION="$(uname -r)"
    ensure_current_dkms_module "$KERNEL_VERSION"
fi

if ! skip_dkms; then
    depmod -a >/dev/null 2>&1 || true
    modprobe "$DKMS_NAME" >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
    systemctl restart "$SERVICE_NAME" >/dev/null 2>&1 || true
fi

exit 0
