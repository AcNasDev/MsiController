# Generated by scripts/build-arch-package.sh from the current Git checkout.
pkgname=msicontroller
pkgver=@VERSION@
pkgrel=@RELEASE@
pkgdesc='MSI laptop control center with a DKMS-managed EC kernel module'
arch=('x86_64')
url='https://github.com/AcNasDev/MsiController'
license=('MIT')
depends=(
  'dkms' 'systemd' 'dbus' 'kmod'
  'libglvnd' 'libxkbcommon' 'libxkbcommon-x11'
  'fontconfig' 'freetype2' 'libx11' 'libxcb'
  'xcb-util' 'xcb-util-cursor' 'xcb-util-image'
  'xcb-util-keysyms' 'xcb-util-renderutil' 'xcb-util-wm'
)
makedepends=('cmake' 'ninja' 'python')
optdepends=('linux-headers: headers for the stock Arch kernel; use matching headers for other kernels')
install=msicontroller.install
source=("MsiController-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  : "${MSICONTROLLER_QT_HOST_DIR:?Build with scripts/build-arch-package.sh or set the Qt 6.11.1 directory}"
  export PATH="${MSICONTROLLER_QT_HOST_DIR}/bin:${PATH}"
  cmake -S "${srcdir}/MsiController-${pkgver}" -B "${srcdir}/build" -G Ninja \
    -DCMAKE_PREFIX_PATH="${MSICONTROLLER_QT_HOST_DIR}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/msicontroller \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DMSICONTROLLER_VERSION_OVERRIDE="${pkgver}" \
    -DMSICONTROLLER_BUNDLE_QT_RUNTIME=ON \
    -DMSICONTROLLER_BUILD_KERNEL_MODULE=OFF \
    -DMSICONTROLLER_INSTALL_DKMS=ON \
    -DMSICONTROLLER_BUILD_TESTS=OFF
  cmake --build "${srcdir}/build" --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"

  install -Dm644 "${srcdir}/MsiController-${pkgver}/cmake/packaging/arch/forgejo-repository.asc" \
    "${pkgdir}/usr/share/msicontroller/forgejo-repository.asc"
  install -Dm644 "${srcdir}/MsiController-${pkgver}/cmake/packaging/arch/90-msicontroller-service.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/90-msicontroller-service.hook"
  install -Dm755 "${srcdir}/MsiController-${pkgver}/cmake/packaging/arch/arch-service-after-dkms.sh" \
    "${pkgdir}/usr/lib/msicontroller/arch-service-after-dkms"

  # Arch places systemd units under /usr/lib; the common CMake path is /lib.
  install -d "${pkgdir}/usr/lib/systemd/system"
  mv "${pkgdir}/lib/systemd/system/msi-ec-service.service" \
    "${pkgdir}/usr/lib/systemd/system/msi-ec-service.service"
  rmdir "${pkgdir}/lib/systemd/system" "${pkgdir}/lib/systemd" "${pkgdir}/lib"

  # Loading at install time would run before Arch's DKMS build hook.
  # ExecStartPre in the service loads the module after DKMS has finished.
  rm "${pkgdir}/etc/modules-load.d/msiecmodule.conf"
  rmdir "${pkgdir}/etc/modules-load.d"
}
